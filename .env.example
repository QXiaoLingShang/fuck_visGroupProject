# 组信息模板（.env.example）
#
# 用法：
#   1. 复制本文件为 .env          cp .env.example .env
#   2. 把下面的占位值替换成本组真实信息
#   3. .env 已被 .gitignore 忽略，不会进入版本库，也不会被公开
#
# 说明：
#   - 姓名、学号属于个人信息，只存放在本机 .env 中；仓库里只有这份占位模板。
#   - 缺少 .env 时 src/build_report.py 仍能生成文档，但署名为占位符
#     （含“姓名”“学号”字样的占位值会被自动识别，文档不具提交效力）。
#   - 组长用 MEMBER_X_LEADER=true 标记，未标记时默认 A 为组长。
#   - 值中含空格时请用双引号包裹，例如 PROJECT_NAME="某某 项目"。

# ---------------------------------------------------------------- 组与项目
GROUP_NO=15
PROJECT_NAME=职数洞见多变量招聘数据可视分析

# ---------------------------------------------------------------- 成员 A（组长）
MEMBER_A_NAME=成员A姓名
MEMBER_A_ID=学号
MEMBER_A_LEADER=true

# ---------------------------------------------------------------- 成员 B
MEMBER_B_NAME=成员B姓名
MEMBER_B_ID=学号
MEMBER_B_LEADER=false

# ---------------------------------------------------------------- 成员 C
MEMBER_C_NAME=成员C姓名
MEMBER_C_ID=学号
MEMBER_C_LEADER=false

# ---------------------------------------------------------------- 成员 D
MEMBER_D_NAME=成员D姓名
MEMBER_D_ID=学号
MEMBER_D_LEADER=false

# ---------------------------------------------------------------- 成员 E
MEMBER_E_NAME=成员E姓名
MEMBER_E_ID=学号
MEMBER_E_LEADER=false
